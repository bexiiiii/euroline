# Copy to .env only on the server. Do not commit the actual file.
POSTGRES_USER=euroline
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
RABBIT_USER=euroline
RABBIT_PASSWORD=replace-with-a-long-random-password
S3_ACCESS_KEY=euroline-storage
S3_SECRET_KEY=replace-with-a-long-random-password
S3_ENDPOINT=https://euroline.getlinkhr.online/storage
S3_INTERNAL_ENDPOINT=http://rustfs:9000
JWT_SECRET=replace-with-a-long-random-jwt-secret
CML_USERNAME=cml-service
CML_PASSWORD=replace-with-a-long-random-password
LAXIMO_LOGIN=
LAXIMO_PASSWORD=
UMAPI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
PUBLIC_ORIGIN=https://euroline.getlinkhr.online
CORS_ALLOWED_ORIGINS=https://euroline.getlinkhr.online

# Outbound orders: enable only after installing SiteIntegration and configuring access.
ONEC_ORDERS_ENABLED=false
ONEC_ORDERS_URL=https://lgnam.kz:1909/EliPas/hs/siteintegration/orders
ONEC_ORDERS_USERNAME=site_backend_user
ONEC_ORDERS_PASSWORD=
ONEC_ORDERS_CA_CERTIFICATE=/app/certs/astra_ca.crt
ONEC_ORDER_ORGANIZATION_REF_KEY=
ONEC_ORDER_WAREHOUSE_REF_KEY=
# v24.11 compatibility: verifies the draft and completes empty total/currency fields.
ONEC_ORDERS_ODATA_URL=https://lgnam.kz:1909/EliPas/odata/standard.odata
ONEC_ORDER_CURRENCY_REF_KEY=
# Set a rollout cutoff to leave older orders for explicit review.
ONEC_ORDERS_CREATED_AFTER=1970-01-01T00:00:00
ONEC_EVENTS_TOKEN=replace-with-a-long-random-token
